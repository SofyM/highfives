<div class="min-h-screen flex items-center justify-center p-4 relative">
  <button
    type="button"
    onclick="toggleTheme()"
    class="absolute top-4 right-4 px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition"
    title="Toggle dark mode">
    <span class="hidden dark:inline">☀️</span>
    <span class="dark:hidden">🌙</span>
  </button>
  <div class="w-full max-w-md">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-[rgb(58_187_139)] mb-2">✋ High5</h1>
        <p class="text-gray-600 dark:text-gray-400">Choose how to sign in</p>
      </div>

      <div class="space-y-4">
        <% @connections.each do |conn| %>
          <%= form_tag auth_authorize_path, method: :post do %>
            <%= hidden_field_tag :connection_id, conn.id %>
            <%= submit_tag "#{conn.connection_type} — #{conn.name}",
                class: "w-full px-6 py-3 bg-[rgb(58_187_139)] hover:bg-[rgb(46_156_114)] text-white font-semibold rounded-lg border-2 border-transparent dark:bg-transparent dark:text-[rgb(58_187_139)] dark:border-[rgb(58_187_139)] dark:hover:bg-[rgba(46,156,114,0.15)] cursor-pointer transition" %>
          <% end %>
        <% end %>
      </div>

      <div class="mt-6 text-center">
        <%= link_to "← Back", login_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:underline" %>
      </div>
    </div>
  </div>
</div>
